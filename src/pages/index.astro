---
import Layout from "../layouts/Layout.astro";
import Flacon from "../components/Flacon.astro";
import CarteParfum from "../components/CarteParfum.astro";
import TestParfum from "../components/TestParfum.astro";
import { parfums, familles } from "../data/parfums";

// Paliers du filtre de prix de la collection (« Moins de … € »)
const plafonds = [50, 70, 90, 110, 130];

// Ordre de départ : les plus appréciés d'abord (comme le tri par défaut)
const collection = [...parfums].sort((a, b) => b.popularite - a.popularite);
const filtresFamille = [
  { nom: "Tous", nombre: parfums.length },
  ...familles.map((f) => ({ nom: f, nombre: parfums.filter((p) => p.famille === f).length })),
];

const horaires = [
  ["Lundi", "Fermé"],
  ["Mardi – Vendredi", "10h00 – 19h00"],
  ["Samedi", "10h00 – 20h00"],
  ["Dimanche", "11h00 – 18h00"],
];

// Fiche « magasin » lue par Google (adresse, téléphone, horaires dans les résultats de recherche)
const ouverture = (jours: string[], debut: string, fin: string) => ({
  "@type": "OpeningHoursSpecification",
  dayOfWeek: jours,
  opens: debut,
  closes: fin,
});
const magasin = {
  "@context": "https://schema.org",
  "@type": "Store",
  name: "Maison Ambre",
  description: "Parfumerie de créateur : parfums artisanaux composés à Grasse.",
  telephone: "+33 1 23 45 67 89",
  priceRange: "€€",
  address: {
    "@type": "PostalAddress",
    streetAddress: "12 rue des Parfumeurs",
    postalCode: "75003",
    addressLocality: "Paris",
    addressCountry: "FR",
  },
  openingHoursSpecification: [
    ouverture(["Tuesday", "Wednesday", "Thursday", "Friday"], "10:00", "19:00"),
    ouverture(["Saturday"], "10:00", "20:00"),
    ouverture(["Sunday"], "11:00", "18:00"),
  ],
};
---

<Layout jsonLd={magasin}>
  <!-- ===== Bannière d'accueil ===== -->
  <section class="hero">
    <div class="conteneur hero__inner">
      <div class="hero__texte">
        <p class="surtitre">Parfumerie de créateur · Paris</p>
        <h1>L'art de laisser <em>une trace</em> inoubliable.</h1>
        <p class="hero__intro">
          Des parfums composés à la main à Grasse, avec des matières premières d'exception.
          Venez découvrir votre signature olfactive en boutique.
        </p>
        <div class="hero__actions">
          <a href="#collection" class="bouton">Découvrir la collection</a>
          <a href="#boutique" class="bouton bouton--clair">Nous rendre visite</a>
        </div>
      </div>
      <div class="hero__visuel">
        <div class="halo"></div>
        <Flacon couleur="#c8873a" taille="grand" />
      </div>
    </div>
  </section>

  <!-- ===== Test « Le parfum pour vous » ===== -->
  <TestParfum />

  <!-- ===== Collection ===== -->
  <section id="collection" class="section">
    <div class="conteneur">
      <!-- data-haut : en arrivant sur la collection, ce titre se cale en haut de l'écran -->
      <div class="entete-section" data-centre data-haut data-aimant>
        <p class="surtitre">Nos créations</p>
        <h2 class="titre-section">La Collection</h2>
      </div>

      <div class="filtres" role="group" aria-label="Filtrer par famille olfactive">
        {filtresFamille.map((f, i) => (
          <button type="button" class:list={["filtre", { actif: i === 0 }]} data-filtre={f.nom} aria-pressed={i === 0 ? "true" : "false"}>
            {f.nom} <span class="filtre__nombre">{f.nombre}</span>
          </button>
        ))}
      </div>

      <div class="barre-outils">
        <p class="compteur" aria-live="polite"><strong>{parfums.length}</strong> parfums</p>
        <div class="selecteurs">
          <label>
            Pour
            <select id="choix-genre">
              <option value="Tous" data-libelle="Tout le monde">Tout le monde</option>
              <option value="Femme" data-libelle="Femme">Femme</option>
              <option value="Homme" data-libelle="Homme">Homme</option>
              <option value="Mixte" data-libelle="Mixte">Mixte</option>
            </select>
          </label>
          <label>
            Prix
            <select id="choix-prix">
              <option value="tous" data-libelle="Tous les prix">Tous les prix</option>
              {plafonds.map((p) => <option value={p} data-libelle={`Moins de ${p} €`}>Moins de {p} €</option>)}
            </select>
          </label>
          <label>
            Trier par
            <select id="choix-tri">
              <option value="popularite">Meilleures ventes</option>
              <option value="prix-croissant">Prix : du moins cher au plus cher</option>
              <option value="prix-decroissant">Prix : du plus cher au moins cher</option>
              <option value="nouveautes">Nouveautés</option>
              <option value="nom">Nom : de A à Z</option>
            </select>
          </label>
        </div>
      </div>

      <div class="grille">
        {collection.map((p) => <CarteParfum parfum={p} />)}
      </div>

      <div class="aucun" hidden>
        <p>Aucun parfum ne correspond à ces critères.</p>
        <button type="button" class="bouton bouton--clair" id="reinitialiser">Effacer les filtres</button>
      </div>

      <div class="plus">
        <p class="plus__texte"></p>
        <div class="plus__jauge"><span></span></div>
        <button type="button" class="bouton bouton--clair" id="voir-plus">Voir plus de parfums</button>
      </div>
    </div>
  </section>

  <!-- ===== La Maison ===== -->
  <section id="maison" class="section maison" data-aimant>
    <div class="conteneur maison__inner">
      <div>
        <p class="surtitre">Notre histoire</p>
        <h2 class="titre-section">Une maison familiale depuis 1987</h2>
      </div>
      <div class="maison__texte">
        <p>
          Fondée par une famille de parfumeurs grassois, Maison Ambre compose chaque fragrance
          en petites séries, dans le respect des savoir-faire traditionnels.
        </p>
        <ul class="atouts">
          <li><strong>100 %</strong> composés à Grasse</li>
          <li><strong>Conseil</strong> personnalisé en boutique</li>
          <li><strong>Échantillons</strong> offerts à chaque visite</li>
        </ul>
      </div>
    </div>
  </section>

  <!-- ===== Boutique ===== -->
  <section id="boutique" class="section" data-aimant>
    <div class="conteneur boutique">
      <div>
        <p class="surtitre">Venir nous voir</p>
        <h2 class="titre-section">La Boutique</h2>
        <p class="adresse">12 rue des Parfumeurs<br />75003 Paris<br />Métro Saint-Paul</p>
        <a
          class="bouton bouton--clair"
          href="https://www.google.com/maps/search/?api=1&query=Rue%20de%20Turenne%2C%2075003%20Paris"
          target="_blank" rel="noopener"
        >Itinéraire</a>
      </div>
      <table class="horaires">
        <caption>Horaires d'ouverture</caption>
        <tbody>
          {horaires.map(([jour, heures]) => (
            <tr><th scope="row">{jour}</th><td>{heures}</td></tr>
          ))}
        </tbody>
      </table>
    </div>
  </section>

  <!-- ===== Contact ===== -->
  <section id="contact" class="section contact" data-aimant>
    <div class="conteneur contact__inner">
      <p class="surtitre">Une question ?</p>
      <h2 class="titre-section">Écrivez-nous</h2>
      <form
        id="formulaire"
        name="contact"
        method="POST"
        action="/"
        data-netlify="true"
        netlify-honeypot="adresse-web"
      >
        <input type="hidden" name="form-name" value="contact" />
        <!-- Piège anti-spam : champ invisible, seuls les robots le remplissent -->
        <p class="piege" aria-hidden="true">
          <label>Ne pas remplir <input name="adresse-web" tabindex="-1" autocomplete="off" /></label>
        </p>
        <div class="ligne">
          <label>Nom <input name="nom" required autocomplete="name" /></label>
          <label>E-mail <input name="email" type="email" required autocomplete="email" /></label>
        </div>
        <label>Message <textarea name="message" rows="4" required></textarea></label>
        <p class="rgpd">
          Vos données servent uniquement à répondre à votre message.{" "}
          <a href="/politique-de-confidentialite">En savoir plus</a>
        </p>
        <button class="bouton" type="submit">Envoyer</button>
        <p id="etat-envoi" class="etat-envoi" role="status" aria-live="polite"></p>
      </form>
    </div>
  </section>
</Layout>

<script>
  // ===== Collection : filtres, tri et « Voir plus » =====
  const PAR_PAGE = 12;
  const grille = document.querySelector<HTMLElement>("#collection .grille")!;
  const cartes = Array.from(grille.querySelectorAll<HTMLElement>(".carte"));
  const boutonsFamille = document.querySelectorAll<HTMLButtonElement>(".filtre");
  const choixGenre = document.getElementById("choix-genre") as HTMLSelectElement;
  const choixPrix = document.getElementById("choix-prix") as HTMLSelectElement;
  const choixTri = document.getElementById("choix-tri") as HTMLSelectElement;
  const compteur = document.querySelector<HTMLElement>(".compteur")!;
  const blocAucun = document.querySelector<HTMLElement>(".aucun")!;
  const blocPlus = document.querySelector<HTMLElement>(".plus")!;
  const textePlus = document.querySelector<HTMLElement>(".plus__texte")!;
  const jauge = document.querySelector<HTMLElement>(".plus__jauge span")!;
  const boutonPlus = document.getElementById("voir-plus") as HTMLButtonElement;

  const etat = { famille: "Tous", limite: PAR_PAGE };
  const nombre = (c: HTMLElement, cle: string) => Number(c.dataset[cle]);

  const comparateurs: Record<string, (a: HTMLElement, b: HTMLElement) => number> = {
    popularite: (a, b) => nombre(b, "popularite") - nombre(a, "popularite"),
    "prix-croissant": (a, b) => nombre(a, "prix") - nombre(b, "prix"),
    "prix-decroissant": (a, b) => nombre(b, "prix") - nombre(a, "prix"),
    nouveautes: (a, b) =>
      nombre(b, "nouveau") - nombre(a, "nouveau") || nombre(b, "popularite") - nombre(a, "popularite"),
    nom: (a, b) => a.dataset.nom!.localeCompare(b.dataset.nom!, "fr"),
  };

  // Les critères choisis en ce moment
  type Criteres = { famille: string; genre: string; prix: string };
  const criteres = (): Criteres => ({ famille: etat.famille, genre: choixGenre.value, prix: choixPrix.value });

  const correspond = (c: HTMLElement, k: Criteres = criteres()) =>
    (k.famille === "Tous" || c.dataset.famille === k.famille) &&
    (k.genre === "Tous" || c.dataset.genre === k.genre) &&
    (k.prix === "tous" || nombre(c, "prix") < Number(k.prix));

  // Nombre de parfums qu'on obtiendrait avec ces critères
  const compter = (k: Criteres) => cartes.filter((c) => correspond(c, k)).length;

  // Met à jour le chiffre affiché à côté de chaque choix, en tenant compte des autres critères.
  // Un choix qui donnerait 0 parfum est grisé.
  const majChiffres = () => {
    const k = criteres();
    boutonsFamille.forEach((b) => {
      const n = compter({ ...k, famille: b.dataset.filtre! });
      b.querySelector(".filtre__nombre")!.textContent = String(n);
      b.disabled = n === 0 && b.dataset.filtre !== k.famille;
    });
    const majListe = (liste: HTMLSelectElement, cle: "genre" | "prix") => {
      for (const o of liste.options) {
        const n = compter({ ...k, [cle]: o.value });
        o.textContent = `${o.dataset.libelle} (${n})`;
        o.disabled = n === 0 && o.value !== k[cle];
      }
    };
    majListe(choixGenre, "genre");
    majListe(choixPrix, "prix");
  };

  const appliquer = () => {
    majChiffres();
    const retenues = cartes.filter((c) => correspond(c)).sort(comparateurs[choixTri.value]);
    // On remet les cartes dans le bon ordre, puis on n'affiche que les premières
    retenues.forEach((c) => grille.appendChild(c));
    cartes.forEach((c) => (c.hidden = true));
    retenues.slice(0, etat.limite).forEach((c) => (c.hidden = false));

    const total = retenues.length;
    const affiches = Math.min(total, etat.limite);
    compteur.innerHTML = `<strong>${total}</strong> parfum${total > 1 ? "s" : ""}`;
    blocAucun.hidden = total > 0;
    blocPlus.hidden = total === 0;
    textePlus.textContent = `Vous avez vu ${affiches} parfum${affiches > 1 ? "s" : ""} sur ${total}`;
    jauge.style.width = `${total ? (affiches / total) * 100 : 0}%`;
    boutonPlus.hidden = affiches >= total;
  };

  const choisirFamille = (famille: string) => {
    etat.famille = famille;
    etat.limite = PAR_PAGE;
    boutonsFamille.forEach((b) => {
      const actif = b.dataset.filtre === famille;
      b.classList.toggle("actif", actif);
      b.setAttribute("aria-pressed", String(actif));
    });
    appliquer();
  };

  boutonsFamille.forEach((b) => b.addEventListener("click", () => choisirFamille(b.dataset.filtre!)));
  [choixGenre, choixPrix, choixTri].forEach((s) =>
    s.addEventListener("change", () => {
      etat.limite = PAR_PAGE;
      appliquer();
    }),
  );
  boutonPlus.addEventListener("click", () => {
    etat.limite += PAR_PAGE;
    appliquer();
  });
  document.getElementById("reinitialiser")!.addEventListener("click", () => {
    choixGenre.value = "Tous";
    choixPrix.value = "tous";
    choisirFamille("Tous");
  });
  // Demandé par le test « Le parfum pour vous » : afficher toute une famille
  document.addEventListener("filtrer-famille", (e) => {
    choixGenre.value = "Tous";
    choixPrix.value = "tous";
    choisirFamille((e as CustomEvent<string>).detail);
  });

  appliquer();

  // ===== Formulaire de contact (Netlify Forms) =====
  // Envoi sans recharger la page. Sans JavaScript, le formulaire est envoyé normalement à Netlify.
  const form = document.getElementById("formulaire") as HTMLFormElement;
  const boutonEnvoi = form.querySelector<HTMLButtonElement>("button[type='submit']")!;
  const etatEnvoi = document.getElementById("etat-envoi")!;
  const afficherEtat = (texte: string, type: "succes" | "erreur" | "") => {
    etatEnvoi.textContent = texte;
    etatEnvoi.dataset.type = type;
  };
  form.addEventListener("submit", async (e) => {
    e.preventDefault();
    boutonEnvoi.disabled = true;
    boutonEnvoi.textContent = "Envoi en cours…";
    afficherEtat("", "");
    try {
      const donnees = new URLSearchParams(new FormData(form) as unknown as Record<string, string>);
      const reponse = await fetch("/", {
        method: "POST",
        headers: { "Content-Type": "application/x-www-form-urlencoded" },
        body: donnees.toString(),
      });
      if (!reponse.ok) throw new Error(`HTTP ${reponse.status}`);
      form.reset();
      afficherEtat("Merci ! Votre message a bien été envoyé, nous vous répondrons rapidement.", "succes");
    } catch {
      afficherEtat(
        "Désolé, le message n'a pas pu être envoyé. Réessayez dans un instant ou appelez-nous au 01 23 45 67 89.",
        "erreur",
      );
    } finally {
      boutonEnvoi.disabled = false;
      boutonEnvoi.textContent = "Envoyer";
    }
  });
</script>

<style>
  /* Bannière */
  .hero { background: linear-gradient(160deg, var(--creme) 40%, var(--sable)); overflow: hidden; }
  .hero__inner {
    display: grid; grid-template-columns: 1.2fr 1fr; align-items: center;
    gap: 2rem; min-height: 78vh; padding: 4rem 0;
  }
  h1 { font-size: clamp(2.6rem, 6vw, 4.5rem); margin-bottom: 1.5rem; }
  h1 em { color: var(--or); }
  .hero__intro { max-width: 46ch; color: var(--gris); margin-bottom: 2rem; }
  .hero__actions { display: flex; gap: 1rem; flex-wrap: wrap; }
  .hero__visuel { position: relative; display: grid; place-items: center; min-height: 380px; }
  .halo {
    position: absolute; width: 340px; height: 340px; border-radius: 50%;
    background: radial-gradient(circle, rgba(200,135,58,0.35), transparent 70%);
  }

  /* Collection */
  .entete-section { text-align: center; }
  .filtres { display: flex; justify-content: center; flex-wrap: wrap; gap: 0.5rem; margin: 1rem 0 2.5rem; }
  .filtre {
    background: none; border: 1px solid var(--sable); padding: 0.45rem 1.1rem;
    font-family: var(--sans); font-size: 0.8rem; cursor: pointer; color: var(--encre);
    border-radius: 999px; transition: all 0.2s;
  }
  .filtre:hover { border-color: var(--or); }
  .filtre.actif { background: var(--encre); color: var(--creme); border-color: var(--encre); }
  .filtre__nombre { font-size: 0.7rem; opacity: 0.6; margin-left: 0.15rem; }
  .filtre:disabled { opacity: 0.35; cursor: not-allowed; }
  .filtre:disabled:hover { border-color: var(--sable); }
  .barre-outils {
    display: flex; justify-content: space-between; align-items: flex-end; flex-wrap: wrap; gap: 1rem;
    padding: 1rem 0; margin-bottom: 1.5rem; border-block: 1px solid var(--sable);
  }
  .compteur { font-size: 0.9rem; color: var(--gris); }
  .compteur strong { color: var(--encre); font-weight: 500; }
  .selecteurs { display: flex; flex-wrap: wrap; gap: 0.75rem; }
  .selecteurs label { display: grid; gap: 0.25rem; font-size: 0.7rem; letter-spacing: 0.12em; text-transform: uppercase; color: var(--gris); }
  .selecteurs select {
    font: inherit; font-size: 0.85rem; letter-spacing: 0; text-transform: none; color: var(--encre);
    padding: 0.55rem 2rem 0.55rem 0.75rem; border: 1px solid #d8ccba; background-color: white; cursor: pointer;
    appearance: none; border-radius: 0;
    background-image: linear-gradient(45deg, transparent 50%, var(--gris) 50%), linear-gradient(135deg, var(--gris) 50%, transparent 50%);
    background-position: calc(100% - 15px) 52%, calc(100% - 10px) 52%;
    background-size: 5px 5px; background-repeat: no-repeat;
  }
  .selecteurs select:focus-visible { outline: 2px solid var(--or); outline-offset: 1px; }
  .grille { display: grid; grid-template-columns: repeat(auto-fill, minmax(240px, 1fr)); gap: 1.5rem; }
  .aucun { text-align: center; padding: 3rem 0; color: var(--gris); }
  .aucun p { margin-bottom: 1rem; }
  .plus { display: grid; justify-items: center; gap: 0.75rem; margin-top: 3rem; }
  .plus__texte { font-size: 0.85rem; color: var(--gris); }
  .plus__jauge { width: min(240px, 100%); height: 2px; background: var(--sable); }
  .plus__jauge span { display: block; height: 100%; background: var(--encre); transition: width 0.3s; }
  #voir-plus { margin-top: 0.5rem; }

  /* Maison */
  .maison { background: var(--encre); color: var(--sable); }
  .maison__inner { display: grid; grid-template-columns: 1fr 1fr; gap: 3rem; align-items: center; }
  .maison__texte p { color: #cfc5b8; margin-bottom: 2rem; }
  .atouts { list-style: none; display: grid; gap: 1rem; }
  .atouts li { border-top: 1px solid #3a322c; padding-top: 1rem; }
  .atouts strong { font-family: var(--serif); font-size: 1.4rem; font-weight: 400; color: var(--or); margin-right: 0.5rem; }

  /* Boutique */
  .boutique { display: grid; grid-template-columns: 1fr 1fr; gap: 3rem; align-items: start; }
  .adresse { margin-bottom: 1.5rem; color: var(--gris); }
  .horaires { width: 100%; border-collapse: collapse; background: white; }
  .horaires caption { text-align: left; font-family: var(--serif); font-size: 1.4rem; padding-bottom: 0.75rem; }
  .horaires th, .horaires td { padding: 0.9rem 1.25rem; border-bottom: 1px solid var(--sable); text-align: left; }
  .horaires th { font-weight: 500; }
  .horaires td { text-align: right; color: var(--gris); }

  /* Contact */
  .contact { background: var(--sable); }
  .contact__inner { max-width: 680px; text-align: center; }
  form { display: grid; gap: 1rem; text-align: left; margin-top: 1.5rem; }
  .ligne { display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; }
  label { display: grid; gap: 0.35rem; font-size: 0.8rem; font-weight: 500; }
  input, textarea {
    font: inherit; font-weight: 300; padding: 0.8rem; border: 1px solid #d8ccba;
    background: var(--creme); color: var(--encre);
  }
  input:focus, textarea:focus { outline: 2px solid var(--or); outline-offset: -1px; }
  form .bouton { justify-self: start; }
  .etat-envoi:empty { display: none; }
  .etat-envoi { font-size: 0.9rem; font-weight: 500; padding: 0.8rem 1rem; border-left: 2px solid var(--or); background: var(--creme); color: var(--or-fonce); }
  .etat-envoi[data-type="erreur"] { border-left-color: #9b3b2e; color: #9b3b2e; }
  form .bouton:disabled { opacity: 0.6; cursor: wait; }
  form .bouton:disabled:hover { background: var(--encre); color: var(--creme); }
  /* Champ anti-spam caché à l'écran (mais présent pour les robots) */
  .piege { position: absolute; left: -9999px; width: 1px; height: 1px; overflow: hidden; }
  .rgpd { font-size: 0.75rem; color: var(--gris); }
  .rgpd a { text-decoration: underline; }

  @media (max-width: 800px) {
    .hero__inner, .maison__inner, .boutique { grid-template-columns: 1fr; }
    .hero__inner { min-height: auto; }
    .hero__visuel { min-height: 300px; }
    .ligne { grid-template-columns: 1fr; }
    /* 16 px minimum : sinon l'iPhone zoome tout seul quand on touche un champ */
    input, textarea, .selecteurs select { font-size: 16px; }
    .filtre { min-height: 40px; padding-inline: 1rem; }
  }
</style>
